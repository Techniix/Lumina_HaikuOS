resource app_signature "application/x-vnd.Lumina-Mode";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Lumina Mode",
	long_info = "Lumina Mode — part of Lumina for Haiku"
};
resource file_types message {
	"types" = "application/x-vnd.Lumina-Profile"
};
