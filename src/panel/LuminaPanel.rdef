resource app_signature "application/x-vnd.Lumina-Panel";

resource app_flags B_SINGLE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Lumina panel",
	long_info = "Lumina panel — part of Lumina for Haiku"
};

