new file mode 100644
index 0000000..945a8f3
--- /dev/null
+++ b/src/servers/app/drawing/OverlayCompositor.h
@@ -0,0 +1,86 @@
+/*
+ * Copyright 2026, Lumina for Haiku contributors.
+ * Distributed under the terms of the MIT License.
+ *
+ * OverlayCompositor: optional, minimal compositing for a few "overlay"
+ * windows (translucent panels, glass, soft shadows, true fades).
+ *
+ * Ordinary windows are untouched and keep drawing straight into the back
+ * buffer. An overlay window does not clip the windows below it and never
+ * draws into the back buffer itself (its visible region is empty); its
+ * pixels come from the view bitmap of its first child view. When the back
+ * buffer is copied to the front buffer (HWInterface::CopyBackToFront — the
+ * single path every pixel takes to the screen) the copied rectangles are
+ * composed with the overlays first. With no overlay registered nothing
+ * changes and nothing is allocated.
+ *
+ * Clients reach it through a small, versioned C API resolved at run time
+ * (lumina_overlay_get_api()), so add-ons built for a stock app_server keep
+ * loading on it and simply find no compositor.
+ */
+#ifndef OVERLAY_COMPOSITOR_H
+#define OVERLAY_COMPOSITOR_H
+
+#include <GraphicsDefs.h>
+#include <Locker.h>
+#include <Rect.h>
+#include <Referenceable.h>
+#include <Region.h>
+
+#include <vector>
+
+#include "IntRect.h"
+#include "LuminaOverlayApi.h"
+#include "OverlayCompose.h"
+
+class Desktop;
+class MallocBuffer;
+class RenderingBuffer;
+class ServerBitmap;
+class Window;
+
+
+class OverlayCompositor {
+public:
+								OverlayCompositor();
+								~OverlayCompositor();
+
+			// Called with the desktop window lock held (write).
+			status_t			SetLayer(Window* window,
+									const lumina_overlay_params& params,
+									BRegion& damage);
+			bool				RemoveLayer(Window* window, BRegion& damage);
+			// Re-reads frames/bitmaps of all layers (after moves, resizes,
+			// show/hide); returns old+new footprints of changed layers.
+			void				Update(BRegion& damage);
+
+			bool				IsActive() const { return fActive; }
+
+			// HWInterface side (HWInterface lock held, any mode).
+			// Composes `area` of the back buffer into the composed buffer.
+			void				Compose(RenderingBuffer* back,
+									const IntRect& area);
+			RenderingBuffer*	ComposedBuffer() const;
+
+private:
+			struct Layer {
+				Window*						window;
+				BRect						frame;
+				BReference<ServerBitmap>	content;
+				lumina_overlay_params		params;
+				bool						visible;
+			};
+
+			void				_Snapshot(Layer& layer);
+			BRect				_Footprint(const Layer& layer) const;
+			void				_EnsureComposed(RenderingBuffer* back);
+
+			BLocker				fLock;
+			std::vector<Layer>	fLayers;
+			MallocBuffer*		fComposed;
+			bool				fComposedValid;
+			bool				fActive;
+			std::vector<uint8>	fScratch;
+};
+
+#endif	// OVERLAY_COMPOSITOR_H
